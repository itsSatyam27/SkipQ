{
  "expo": {
    "name": "SkipQ",
    "slug": "skipq-app",
    "owner": "skipqofficial",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c4156da2-9497-4ed1-9dbf-51ac4d66f0eb",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skipq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SkipQ uses location to automatically discover nearest registered campus canteens.",
        "NSCameraUsageDescription": "SkipQ uses camera for instant counter QR code pickup verification."
      }
    },
    "android": {
      "package": "com.skipq.app",
      "targetSdkVersion": 36,
      "compileSdkVersion": 36,
      "adaptiveIcon": {
        "backgroundColor": "#FFB020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkipQ uses your location to find campus canteens and check pickup distance before ordering.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 148,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0C0E",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SkipQ uses camera for instant counter QR code pickup verification.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkipQ lets sellers choose dish photos from their library.",
          "cameraPermission": "SkipQ lets sellers take photos of their dishes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffb313",
          "defaultChannel": "orders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4156da2-9497-4ed1-9dbf-51ac4d66f0eb"
      }
    }
  }
}
