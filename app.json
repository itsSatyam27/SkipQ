{
  "expo": {
    "name": "SkipQ",
    "slug": "skipq-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skipq.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkipQ uses the camera to scan digital pickup pass QR codes at canteen counters.",
        "NSLocationWhenInUseUsageDescription": "SkipQ uses location to automatically discover nearest registered campus canteens."
      }
    },
    "android": {
      "package": "com.skipq.app",
      "targetSdkVersion": 34,
      "compileSdkVersion": 34,
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "c4156da2-9497-4ed1-9dbf-51ac4d66f0eb"
      }
    }
  }
}
