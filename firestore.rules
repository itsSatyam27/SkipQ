rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(userId) { return signedIn() && request.auth.uid == userId; }
    function seller() { return signedIn() && request.auth.token.seller == true; }
    function canteenOwner(canteenId) {
      return seller() && get(/databases/$(database)/documents/canteens/$(canteenId)).data.ownerId == request.auth.uid;
    }

    // A user's private profile is keyed by their verified Firebase UID, never by phone.
    match /users/{userId} {
      allow read: if ownUser(userId);
      allow create: if ownUser(userId)
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['walletBalance', 'banStatus', 'unclaimedOrderCount']);
      allow update: if ownUser(userId)
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['uid', 'authUid', 'phone', 'walletBalance', 'banStatus', 'unclaimedOrderCount', 'userType']);
      allow delete: if false;
    }

    // Campus menus are public; signed-in vendors can create and manage their own canteens.
    match /canteens/{canteenId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid || canteenOwner(canteenId)
      );
    }

    // Vendor applications are private.
    match /sellerRequests/{userId} {
      allow read: if ownUser(userId);
      allow create: if ownUser(userId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Orders are accessible to the buyer and seller.
    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid
      );
      allow delete: if false;
    }

    match /universities/{universityId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
