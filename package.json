{
  "name": "skipq-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~57.0.29",
    "expo-auth-session": "~57.0.16",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "build:admin": "node scripts/build-admin.cjs",
    "admin": "node scripts/build-admin.cjs && python -m http.server 8097 --directory admin/dist --bind 127.0.0.1",
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/check-release.cjs && expo export --platform web",
    "check:release": "node scripts/check-release.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-skipq \"node --test tests/firestore.rules.test.cjs\""
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^15.0.0"
  }
}
